    "@mantine/dates": "^8.3.5",
    "@mantine/dropzone": "^8.3.5",
    "@mantine/form": "^8.3.5",
    "@mantine/hooks": "^8.3.5",
    "@mantine/modals": "^8.3.5",
    "@mantine/notifications": "^8.3.5",
    "@mantine/nprogress": "^8.3.5",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sentry/profiling-node": "^10.8.0",
    "@sentry/tanstackstart-react": "^10.8.0",
    "@statelyai/inspect": "^0.4.0",
    "@tanstack/react-devtools": "^0.7.6",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-router": "1.133.3",
    "@tanstack/react-router-ssr-query": "^1.133.3",
    "@tanstack/react-start": "1.131.28",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@trpc/tanstack-react-query": "^11.6.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@xstate/react": "^6.0.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "drizzle-orm": "^0.44.6",
    "jotai": "^2.15.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-icons": "^5.5.0",
    "server": "link:@tanstack/react-start/server",
    "superjson": "^2.2.2",
    "tmp": "^0.2.5",
    "valtio": "^2.1.8",
    "xstate": "^5.23.0",
